+        static MethodDefinition GetStateMachineTarget(MethodDefinition method)
+        {
+            foreach (var attrib in method.CustomAttributes)
+            {
+                var attribType = attrib.AttributeType.SafeResolve();
+                while (attribType != null)
+                {
+                    if (attribType.FullName == "System.Runtime.CompilerServices.StateMachineAttribute")
+                    {
+                        if (attrib.ConstructorArguments.Count == 0 ||
+                            !(attrib.ConstructorArguments[0].Value is TypeReference stateMachineType))
+                            return null;
+
+                        return stateMachineType.SafeResolve()?.Methods.FirstOrDefault(candidate =>
+                            candidate.Name == "MoveNext" &&
+                            !candidate.IsStatic &&
+                            candidate.Parameters.Count == 0
+                        );
+                    }
+
+                    attribType = attribType.BaseType.SafeResolve();
+                }
+            }
+
+            return null;
